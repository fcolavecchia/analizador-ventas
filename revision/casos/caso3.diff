@@ -0,0 +1,28 @@
+from datetime import date
+from decimal import Decimal
+
+from ventas.analisis import por_categoria
+from ventas.modelos import Venta
+
+
+def test_por_categoria_ordena_por_facturacion_y_desempata_por_nombre():
+    ventas = [
+        Venta("T1", date(2026, 1, 1), "Mouse", "Periféricos", 2, Decimal("50"), "Centro"),
+        Venta("T1", date(2026, 1, 1), "Cable USB", "Accesorios", 4, Decimal("25"), "Centro"),
+        Venta("T2", date(2026, 1, 2), "Monitor", "Computación", 1, Decimal("300"), "Norte"),
+    ]
+
+    assert por_categoria(ventas) == [
+        ("Computación", Decimal("300.00"), 1),
+        ("Accesorios", Decimal("100.00"), 4),
+        ("Periféricos", Decimal("100.00"), 2),
+    ]
+
+
+def test_por_categoria_unifica_mayusculas_y_espacios():
+    ventas = [
+        Venta("T1", date(2026, 1, 1), "Mouse", "Periféricos", 1, Decimal("10"), "Centro"),
+        Venta("T2", date(2026, 1, 2), "Teclado", " PERIFÉRICOS ", 1, Decimal("20"), "Norte"),
+    ]
+
+    assert por_categoria(ventas) == [("Periféricos", Decimal("30.00"), 2)]
