     }
     mensual = {mes: a_dos_decimales(por_mes[mes]) for mes in sorted(por_mes)}
     return resumen, mensual
+
+
+def por_categoria(ventas: list[Venta]) -> list[tuple[str, Decimal, int]]:
+    facturacion: defaultdict[str, Decimal] = defaultdict(lambda: Decimal("0"))
+    unidades: defaultdict[str, int] = defaultdict(int)
+    for venta in ventas:
+        categoria = " ".join(venta.categoria.split()).capitalize()
+        facturacion[categoria] += venta.importe
+        unidades[categoria] += venta.cantidad
+    return [
+        (categoria, a_dos_decimales(facturacion[categoria]), unidades[categoria])
+        for categoria in sorted(facturacion, key=lambda c: (-facturacion[c], c))
+    ]
